# Copia este archivo a .env y completa los valores. El .env NO se sube al repositorio.
PORT=3000
# Dentro de Docker el host es el nombre del servicio (mongo). Fuera de Docker: mongodb://localhost:27017/trionixgear
MONGODB_URI=mongodb://mongo:27017/trionixgear

# Autenticación (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Administrador que crea seed.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudflare Tunnel con nombre (opción B). Vacío si usas Quick Tunnel.
TUNNEL_TOKEN=
